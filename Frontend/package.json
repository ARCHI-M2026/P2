{
  "name": "etudiant-frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "jest",
    "test:watch": "jest --watch",
    "cypress:info": "cypress info",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run",
    "build:cypress:coverage": "ng build --configuration development && npx nyc instrument dist/etudiant-frontend/browser instrumented --complete-copy --delete",
    "serve:cypress:coverage": "serve -s instrumented -l 4200",
    "e2e:coverage:full": "npm run build:cypress:coverage && start-server-and-test serve:cypress:coverage http://localhost:4200 cypress:run",
    "e2e:coverage:report": "nyc report"
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "^19.2.19",
    "@angular/common": "^19.2.0",
    "@angular/compiler": "^19.2.0",
    "@angular/core": "^19.2.0",
    "@angular/forms": "^19.2.0",
    "@angular/material": "^19.2.19",
    "@angular/platform-browser": "^19.2.0",
    "@angular/platform-browser-dynamic": "^19.2.0",
    "@angular/router": "^19.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^19.0.7",
    "@angular/cli": "^19.2.16",
    "@angular/compiler-cli": "^19.2.0",
    "@cypress/code-coverage": "^4.0.3",
    "@types/jest": "^29.5.4",
    "babel-plugin-istanbul": "^8.0.0",
    "cypress": "^15.21.1",
    "istanbul-lib-coverage": "^3.2.2",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-preset-angular": "^14.5.1",
    "nyc": "^18.0.0",
    "serve": "^14.2.6",
    "start-server-and-test": "^3.0.12",
    "typescript": "~5.7.2"
  }
}
